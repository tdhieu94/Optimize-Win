<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OW.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Optimize Win">
    <ScrollViewer>
        <StackPanel MaxWidth="720" Margin="32" Spacing="16">
            <TextBlock Text="Optimize Win" Style="{StaticResource TitleLargeTextBlockStyle}" />
            <TextBlock
                Text="Giai đoạn 1 (đang làm). Mọi thao tác dọn đều có thể hoàn tác trong 7 ngày."
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <InfoBar
                x:Name="StatusBar"
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="Đang kiểm tra dịch vụ OW..." />

            <Button x:Name="RetryButton" Content="Kiểm tra lại" Click="OnRetryClick" />

            <TextBlock Text="Ổ đĩa" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
            <StackPanel x:Name="DisksPanel" Spacing="12">
                <TextBlock Text="Đang đọc thông tin ổ đĩa..." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <TextBlock Text="Dung lượng" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
            <StackPanel x:Name="SpacePanel" />

            <TextBlock Text="Khởi động cùng Windows" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
            <StackPanel x:Name="StartupPanel" />

            <TextBlock Text="Dọn rác" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
            <StackPanel x:Name="CleanPanel" />

            <TextBlock Text="Lịch sử dọn dẹp" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
            <StackPanel x:Name="HistoryPanel" />
        </StackPanel>
    </ScrollViewer>
</Window>
